# Copy to .env (never commit .env). Each sponsor turns green in the app only after a real call works.
GEMINI_API_KEY=           # receipt/bill scanner + agent voice lines (aistudio.google.com → Get API key)
# GEMINI_MODEL=           # optional; by default the server picks a Flash model your key can use
OPENAI_API_KEY=           # alternative to Gemini (platform.openai.com → API keys); Gemini is used if both are set
# OPENAI_MODEL=           # optional, default gpt-6-astra
# AI_PROVIDER=openai      # optional: force OpenAI when both keys are set
TELEM_API_KEY=            # Telem console → API keys
BAND_API_KEY=             # app.band.ai/agents → Connect remote agent (key is shown once)
BAND_CHAT_ID=             # room UUID (BAND app → Chats → your room); add the agent AND yourself
# BAND_BASE=https://app.band.ai/api/v1/agent   # try this if /me returns 404
RUNWARE_API_KEY=          # my.runware.ai (free trial credits)
GLASSER_API_KEY=          # glasser login / Glasser console (needs: npm i -g @glasser-ai/cli@latest, Node 22+)
GLASSER_PLACES_PROVIDER=  # from: glasser search -q "maps places"
GLASSER_PLACES_ENDPOINT=
GLASSER_PLACES_INPUT={"q":"{{q}}"}   # match the input schema from: glasser inspect -p .. -e ..
